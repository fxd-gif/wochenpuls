rules_version = '2';

// Wochenpuls: Firestore ist nur über den Server erreichbar (Admin SDK).
// Der Browser bekommt nie direkten Zugriff — deshalb hier "alles zu".
// Das Admin SDK umgeht diese Regeln immer, ganz gleich was hier steht.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
